NODE_ENV=development
PORT=3000
# Origem exata do frontend (protocolo+host+porta). Usada para restringir o CORS.
FRONTEND_URL=http://localhost:5173

DB_PATH=./data/finance.db
DB_PASSWORD=troque_esta_senha_do_banco

JWT_SECRET=troque_esta_chave_jwt
JWT_EXPIRES_IN=30m

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu_email_de_envio@gmail.com
SMTP_PASS=sua_senha_de_app

# Para onde vao os codigos de 2FA e alertas de seguranca
SECURITY_EMAIL=seu_email_de_seguranca@example.com

# Usuarios de seed (criados apenas se ainda nao existirem no banco).
SEED_USER1_USERNAME=usuario1
SEED_USER1_EMAIL=usuario1@example.com
SEED_USER1_PASSWORD=troque_esta_senha
SEED_USER2_USERNAME=usuario2
SEED_USER2_EMAIL=usuario2@example.com
SEED_USER2_PASSWORD=troque_esta_senha

BACKUP_DIR=./backups
BACKUP_CRON=0 3 * * *

# Usada para ler extratos/faturas em PDF no Assistente de Importacao de
# Extratos. Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_gemini

# Opcional: backup usado se o Gemini falhar (rate limit, indisponibilidade).
# Chave gratuita em https://console.groq.com
GROQ_API_KEY=

# Opcional: sobrescreve o modelo padrao de cada provedor sem precisar
# alterar codigo (provedores de IA depreciam modelos com pouco aviso).
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
